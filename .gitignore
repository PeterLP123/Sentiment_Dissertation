.DS_Store
.env
lseg-data.config.json
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
*.pyc
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
results/*
!results/.gitkeep
# Dated research-run directories contain generated CSV/JSON/log/image outputs.
# Keep narrative source files under reports/ trackable, but require an explicit
# force-add for any generated run directory that is intentionally published.
/reports/*_20??????/
/reports/reproductions/
# Tail-risk bundles contain multi-hundred-MB forecasts and generated figures.
# Track only the compact provenance and result summaries needed to audit a run.
/reports/fnsipid_tail_risk_core_v1/*
!/reports/fnsipid_tail_risk_core_v1/summary.md
!/reports/fnsipid_tail_risk_core_v1/manifest.json
/reports/fnsipid_tail_risk_core_v2/*
!/reports/fnsipid_tail_risk_core_v2/summary.md
!/reports/fnsipid_tail_risk_core_v2/manifest.json
/reports/fnsipid_tail_risk_core_price_only/*
!/reports/fnsipid_tail_risk_core_price_only/summary.md
!/reports/fnsipid_tail_risk_core_price_only/manifest.json
/reports/fnsipid_tail_risk_core_refit_only/*
!/reports/fnsipid_tail_risk_core_refit_only/summary.md
!/reports/fnsipid_tail_risk_core_refit_only/manifest.json
/reports/fnsipid_tail_risk_factorial_v1/*
!/reports/fnsipid_tail_risk_factorial_v1/summary.md
!/reports/fnsipid_tail_risk_factorial_v1/manifest.json
!/reports/fnsipid_tail_risk_factorial_v1/*.csv
!/reports/fnsipid_tail_risk_factorial_v1/ucl_run_record.txt
/reports/fnsipid_tail_risk_explainer_v1/*
!/reports/fnsipid_tail_risk_explainer_v1/README.md
!/reports/fnsipid_tail_risk_explainer_v1/manifest.json
# Jupyter checkpoint copies of the tracked notebook pair.
.ipynb_checkpoints/
# Portable dashboards may be versioned under docs/, but their generated data
# contracts remain local and reproducible from the frozen result artifacts.
/reports/data/recent_news_midcap_finbert_dashboard_artifact.json
# New source datasets and root-level data exports stay local by default.
# Files already tracked in these locations remain tracked; this prevents
# accidentally adding fresh proprietary or generated inputs.
Data/source/
Data/*.csv
Data/*.json
# Apply the collection data boundary to future LSEG collection directories too,
# rather than relying only on each existing collection's nested .gitignore.
Data/collections/*/raw/
Data/collections/*/derived/
Data/collections/*/reports/
Data/collections/*/packages/
Data/news/*
!Data/news/.gitkeep
Data/derived/*
!Data/derived/.gitkeep
!Data/derived/labeled/
!Data/derived/labeled/README.md
!Data/derived/labeled/financial_sentiment_v2.csv
models/
checkpoints/
artifacts/
exports/
# Stray root-level outputs/ from older Week 4 gist commands that used cwd-relative
# --output-dir before clean_lseg_articles.py resolved paths under week_4_tasks/.
# so it never shadows the tracked week_4_tasks/outputs/.gitignore. Keeps
# licensed LSEG story text out of version control.
/outputs/
# Tavily shared news packages are out-of-band deliverables, not source.
tavily_shared_*.zip
# LaTeX build artifacts; dissertation/main.pdf is reproducible via latexmk -pdf,
# so only main.tex and references.bib are tracked.
dissertation/*.aux
dissertation/*.bbl
dissertation/*.bcf
dissertation/*.blg
dissertation/*.fdb_latexmk
dissertation/*.fls
dissertation/*.lof
dissertation/*.log
dissertation/*.lot
dissertation/*.out
dissertation/*.pdf
dissertation/*.run.xml
dissertation/*.synctex.gz
dissertation/*.toc
.foglamp/
.gstack/
